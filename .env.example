# ─── Live Event 3 (Alternative Direct Provider) ────────────────────────────────
EVENT3_BASE_URL=https://example.com
EVENT3_ENDPOINTS=["/endpoint1.json","/endpoint2.json"]
EVENT3_PARSER_RULES={"name_key":"name","category_key":"category","tournament_key":"playing","time_key":"time","timestamp_key":"timestamp","streams_key":"streams","url_key":"url","stream_name_key":"name","indonesia_keywords":["indonesia"]}
