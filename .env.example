# ─── Live Event 2 (RBTV+ Provider) ───────────────────────────────────────────
RBTV_MAIN_URL=https://example.com
RBTV_API_HOST=https://example.com
RBTV_GIST_URL=https://example.com/live_matches.json
RBTV_PATH_BS=/api/common/bs
RBTV_PATH_LIVE=/api/match/live
RBTV_PATH_DETAIL=/api/match/detail
RBTV_USER_AGENT=Mozilla/5.0 ...
RBTV_STREAM_REFERER=https://example.com/
